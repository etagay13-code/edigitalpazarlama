# ============================================================================
# E-Digital Marketing — Environment Variables
# ============================================================================
#
# .env.local'ı bu dosyadan kopyalayıp doldur:
#   cp .env.example .env.local
#
# .env.local Git'e gitmez (.gitignore'da).
# Vercel'e deploy ederken bunları Vercel project settings → Environment Variables
# bölümünden ekleyeceksin.
# ============================================================================

# ---------------------------------------------------------------------------
# SUPABASE
# ---------------------------------------------------------------------------
# 1) supabase.com → Yeni project oluştur
# 2) Project Settings → API → URL ve Anon (public) key'i kopyala
# 3) Project Settings → API → Service Role (secret) key'i KOPYALA (sadece server-side)
#    ⚠️ Service role key'i ASLA istemci tarafına sızdırma. NEXT_PUBLIC_ prefixi YOK.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# ---------------------------------------------------------------------------
# RESEND (iletişim formu maili)
# ---------------------------------------------------------------------------
# resend.com → Yeni API key oluştur (ücretsiz plan: 3000 mail/ay, 100/gün)
# Custom domain ekledikten sonra "from" adresini değiştir.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=hello@onboarding.resend.dev
# ↑ Henüz custom domain bağlanmadıysa onboarding.resend.dev kullan;
#   sadece kendi e-postana mail atabilirsin.
#   Production: hello@edigitalmarketing.com gibi kendi domain'in.

# ---------------------------------------------------------------------------
# SITE
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3001
# Production'da: https://edigitalmarketing.com
